{
  "name": "@outbound-dialer/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src --max-warnings 0",
    "migrate": "node dist/migrate.js",
    "openapi:check": "node ../../scripts/generate-openapi-schemas.mjs --check",
    "openapi:generate": "node ../../scripts/generate-openapi-schemas.mjs",
    "start": "node dist/server.js",
    "test": "npm --workspace @outbound-dialer/shared run build && tsc -p tsconfig.test.json && node --test dist-test/*.test.js dist-test/dashboard/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.1",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "10.1.2",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@outbound-dialer/shared": "0.1.0",
    "archiver": "^8.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.10.0",
    "libphonenumber-js": "^1.13.8",
    "pg": "^8.12.0",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.5.5",
    "@types/pg": "^8.11.6",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
