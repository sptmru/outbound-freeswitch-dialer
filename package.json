{
  "name": "outbound-dialer",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm --workspace @outbound-dialer/shared run build && npm --workspace @outbound-dialer/api run build && npm --workspace @outbound-dialer/web run build",
    "dev:api": "npm --workspace @outbound-dialer/api run dev",
    "dev:web": "npm --workspace @outbound-dialer/web run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "quality": "npm --workspace @outbound-dialer/api run openapi:check && npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "smoke:web": "bash scripts/smoke-web.sh",
    "test": "npm run test --workspaces --if-present && npm run test:ops",
    "test:ops": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:freeswitch": "bash scripts/test-freeswitch-scenarios.sh",
    "test:prototype:ingress": "bash scripts/test-a02-ingress.sh",
    "test:load:desk": "node scripts/load-agent-desk.mjs",
    "test:load:sip-rtp": "node scripts/load-sip-rtp.mjs",
    "test:load:suite": "bash scripts/run-load-suite.sh",
    "test:load:tokens": "node scripts/collect-load-agent-tokens.mjs",
    "typecheck": "npm --workspace @outbound-dialer/shared run build && npm --workspace @outbound-dialer/api run typecheck && npm --workspace @outbound-dialer/web run typecheck",
    "test:voicemail:db": "bash scripts/test-campaign-voicemail.sh",
    "test:prototype:durable-ingress": "bash scripts/test-a03-ingress.sh",
    "test:prototype:desk-binding": "bash scripts/test-a04-binding.sh",
    "test:prototype:rebridge": "bash scripts/test-a05-rebridge.sh",
    "test:prototype:budgets": "bash scripts/test-a06-budgets.sh",
    "test:inbound:db": "node scripts/run-inbound-db.mjs",
    "test:inbound:db:isolated": "bash scripts/test-inbound-db.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@fastify/static": "10.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.5",
    "typescript-eslint": "^8.63.0"
  }
}
