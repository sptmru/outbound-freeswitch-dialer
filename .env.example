# Runtime
NODE_ENV=production
PUBLIC_APP_URL=https://dialer.example.com
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info
MONITORING_STUCK_CALL_SECONDS=900
CORS_ORIGINS=https://dialer.example.com,http://localhost:5173,http://localhost:3000
VITE_API_BASE_URL=/api
# Keep SIP credentials and signaling out of production browser consoles. Enable only for a short diagnostic session.
VITE_SIP_DIAGNOSTICS=false

# Auth
JWT_SECRET=change-me-long-random-session-secret-at-least-32-chars
JWT_EXPIRES_SECONDS=28800
# Dedicated key for reversible SIP credentials. The first dual-read deployment keeps v1 writes;
# do not rotate JWT_SECRET until a later v2 migration has completed and no v1 rows remain.
SIP_SECRET_ENCRYPTION_KEY=change-me-independent-sip-encryption-key-at-least-32-chars
# Stage this migration: deploy dual-read code with v1 first, then enable v2 only
# after the immediately previous image is known to read both formats.
SIP_SECRET_WRITE_VERSION=v1
SIP_SECRET_V2_ROLLBACK_SAFE=false
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
CONTACT_MAX_ATTEMPTS=3
CONTACT_RETRY_DELAY_SECONDS=900
ORIGINATE_AGENT_WATCHDOG_SECONDS=35
ORIGINATE_CUSTOMER_WATCHDOG_SECONDS=50
ORIGINATE_WATCHDOG_RETRY_SECONDS=5
ORIGINATE_WATCHDOG_MAX_RETRIES=3
CALL_HISTORY_EXPORT_MAX_ROWS=50000
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
BOOTSTRAP_ADMIN_NAME=Admin
DEFAULT_PHONE_COUNTRY_CODE=US
SIP_USERNAME_PREFIX=agent
FREESWITCH_GENERATED_CONFIG_DIR=/var/lib/outbound-dialer/freeswitch
VOICEMAIL_RECORDINGS_STORAGE_DIR=/var/lib/freeswitch/storage/recordings
VOICEMAIL_UPLOAD_MAX_BYTES=67108864
VOICEMAIL_DROP_START_TIMEOUT_SECONDS=120
# Allows multipart overhead above the 64 MiB voicemail file limit.
PROXY_MAX_REQUEST_BODY_SIZE=70m
CALL_RECORDINGS_STORAGE_DIR=/var/lib/freeswitch/storage/recordings/calls
CALL_LOG_RETENTION_DAYS=7
CALL_RECORDING_RETENTION_DAYS=30
RETENTION_ENABLED=true
RETENTION_RUN_INTERVAL_SECONDS=86400
MEDIA_TICKET_TTL_SECONDS=60
MEDIA_TICKET_MAX_LIFETIME_SECONDS=14400
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FREESWITCH_CONFIG_DIR=/usr/share/freeswitch/conf/vanilla

# PostgreSQL
POSTGRES_DB=outbound_dialer
POSTGRES_USER=outbound_dialer
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgres://outbound_dialer:change-me-postgres-password@postgres:5432/outbound_dialer
# Independent least-privilege login used only by postgres-exporter.
POSTGRES_EXPORTER_PASSWORD=change-me-long-random-postgres-exporter-password

# FreeSWITCH Event Socket
FREESWITCH_ESL_ENABLED=true
FREESWITCH_ESL_HOST=host.docker.internal
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=change-me-esl-password
FREESWITCH_ESL_ACL=any_v4.auto
FREESWITCH_ESL_EVENT_QUEUE_MAX_SIZE=1000
FREESWITCH_ESL_EVENT_RETRY_INITIAL_MS=250
FREESWITCH_ESL_EVENT_RETRY_MAX_MS=30000
FREESWITCH_ESL_RECONCILE_INTERVAL_SECONDS=60

# FreeSWITCH image and network shape
FREESWITCH_BASE_IMAGE=safarov/freeswitch@sha256:b31c743f4c911a19687c61e3214968f2a24f93f9d3d667cc26284192e158ffc6
FREESWITCH_DOMAIN=dialer.example.com
FREESWITCH_RTP_START_PORT=16384
FREESWITCH_RTP_END_PORT=16484
# AWS maps the Elastic IP to the instance's private address. FreeSWITCH must
# advertise the literal Elastic IP; auto-nat relies on UPnP/NAT-PMP and is not valid on EC2.
FREESWITCH_EXTERNAL_SIP_IP=203.0.113.10
FREESWITCH_EXTERNAL_RTP_IP=203.0.113.10
FREESWITCH_INTERNAL_SIP_PORT=5060
FREESWITCH_EXTERNAL_PROFILE_SIP_PORT=5080
FREESWITCH_EXTERNAL_PROFILE_TLS_PORT=5081
FREESWITCH_WEBRTC_WSS_PORT=7443

# Automatic per-call SIP/RTP packet capture. Final files are isolated using
# persisted SIP Call-IDs and local media ports, but still contain sensitive
# customer traffic and are available only to admins through Call History.
PCAP_CAPTURE_ENABLED=false
PCAP_CAPTURE_INTERFACE=any
PCAP_RETENTION_DAYS=7
FREESWITCH_WEBRTC_PUBLIC_WS_URL=wss://dialer.example.com/freeswitch-ws
FREESWITCH_WS_UPSTREAM_SCHEME=https
FREESWITCH_WS_UPSTREAM=host.docker.internal:7443
FREESWITCH_WS_UPSTREAM_TLS_VERIFY=off
FREESWITCH_WS_UPSTREAM_TLS_SERVER_NAME=dialer.example.com
# The same-host FreeSWITCH listener uses its generated self-signed certificate;
# this explicitly approved upstream stays on the EC2 host and is never exposed publicly.
ALLOW_UNVERIFIED_FREESWITCH_WS_UPSTREAM=true

# Browser ICE. Coturn shares the primary dialer hostname but listens on the
# standard TURN ports. TURN_RELAY_IP is the address assigned to the host interface:
# the private IPv4 on AWS/NAT, or the same public IPv4 on a directly addressed server.
ICE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=turn:dialer.example.com:3478?transport=udp,turn:dialer.example.com:3478?transport=tcp,turns:dialer.example.com:5349?transport=tcp
TURN_SHARED_SECRET=change-me-long-random-turn-shared-secret-at-least-32-chars
TURN_CREDENTIAL_TTL_SECONDS=3600
TURN_RELAY_IP=10.0.1.10
COTURN_IMAGE=coturn/coturn:4.14.0-r0@sha256:0c0e8fc0c263b85a134e9e4242b5e46e1f4c077c5029633511191c05b5c2c814
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_MIN_PORT=49152
TURN_MAX_PORT=49252
TURN_USER_QUOTA=4
TURN_TOTAL_QUOTA=200

# SIP trunk. Fill once provider details are known.
SIP_TRUNK_MODE=registration
SIP_TRUNK_PROXY=
SIP_TRUNK_REALM=
SIP_TRUNK_OUTBOUND_PROXY=
SIP_TRUNK_USERNAME=
SIP_TRUNK_PASSWORD=
SIP_TRUNK_CALLER_ID=
# Production preflight requires a usable trunk tuple. Set this only for an explicitly
# approved internal/non-provider deployment where outbound customer calls are unavailable.
ALLOW_UNCONFIGURED_SIP_TRUNK=false

# Public ports
HTTP_PORT=80
HTTPS_PORT=443
API_PUBLIC_PORT=3000
WEB_PUBLIC_PORT=8080
SIP_PORT=5060
WSS_PORT=7443

# Fail2ban
TZ=UTC
FAIL2BAN_LOG_LEVEL=INFO
FAIL2BAN_DB_PURGE_AGE=7d

# Monitoring
GRAFANA_DOMAIN=grafana.example.com
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-long-random-grafana-password
PROMETHEUS_RETENTION=30d
LOKI_RETENTION_PERIOD=336h
ALERTMANAGER_RETENTION=120h
ALERTMANAGER_REPEAT_INTERVAL=4h
# Optional notification destinations. Leave blank to keep alerts in the UI only.
ALERTMANAGER_WEBHOOK_URL=
ALERTMANAGER_TELEGRAM_BOT_TOKEN=
ALERTMANAGER_TELEGRAM_CHAT_ID=

# Authenticated encrypted backups. Production preflight requires off-host S3
# unless the local-only risk is explicitly accepted.
BACKUP_ENCRYPTION_PASSPHRASE=change-me-long-random-backup-encryption-passphrase
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_QUIESCE_SERVICES=true
# Break-glass only: a non-quiesced database/media bundle is not a consistent recovery point.
ALLOW_NON_QUIESCED_BACKUP=false
BACKUP_S3_URI=
ALLOW_LOCAL_ONLY_BACKUPS=false
BACKUP_CRON_SCHEDULE="37 2 * * *"
# Emergency upgrade-only override; normal deploys fail closed when active-call state is unavailable.
ALLOW_UNVERIFIED_ACTIVE_CALL_STATE=false
# Explicit emergency override. Production preflight otherwise requires a notification receiver.
ALLOW_NO_ALERT_RECEIVER=false

# TLS / Let's Encrypt automation covers the dialer and Grafana domains.
LETSENCRYPT_EMAIL=admin@example.com
LETSENCRYPT_DOMAIN=dialer.example.com
