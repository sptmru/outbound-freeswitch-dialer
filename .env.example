# Runtime
NODE_ENV=production
PUBLIC_APP_URL=https://dialer.example.com
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=https://dialer.example.com,http://localhost:5173,http://localhost:3000

# Auth
JWT_SECRET=change-me-long-random-session-secret-at-least-32-chars
JWT_EXPIRES_SECONDS=86400
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
BOOTSTRAP_ADMIN_NAME=Admin
SIP_USERNAME_PREFIX=agent
FREESWITCH_GENERATED_CONFIG_DIR=/var/lib/outbound-dialer/freeswitch
FREESWITCH_CONFIG_DIR=/usr/share/freeswitch/conf/vanilla

# PostgreSQL
POSTGRES_DB=outbound_dialer
POSTGRES_USER=outbound_dialer
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgres://outbound_dialer:change-me-postgres-password@postgres:5432/outbound_dialer

# FreeSWITCH Event Socket
FREESWITCH_ESL_ENABLED=true
FREESWITCH_ESL_HOST=host.docker.internal
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=change-me-esl-password
FREESWITCH_ESL_ACL=any_v4.auto

# FreeSWITCH image and network shape
FREESWITCH_BASE_IMAGE=safarov/freeswitch:latest
FREESWITCH_DOMAIN=dialer.example.com
FREESWITCH_RTP_START_PORT=16384
FREESWITCH_RTP_END_PORT=16484
FREESWITCH_EXTERNAL_SIP_IP=auto-nat
FREESWITCH_EXTERNAL_RTP_IP=auto-nat
FREESWITCH_INTERNAL_SIP_PORT=5060
FREESWITCH_EXTERNAL_PROFILE_SIP_PORT=5080
FREESWITCH_EXTERNAL_PROFILE_TLS_PORT=5081
FREESWITCH_WEBRTC_WSS_PORT=7443

# Maxo SIP trunk. Fill once provider details are known.
MAXO_TRUNK_MODE=registration
MAXO_SIP_PROXY=
MAXO_SIP_REALM=
MAXO_OUTBOUND_PROXY=
MAXO_USERNAME=
MAXO_PASSWORD=
MAXO_CALLER_ID=

# Public ports
HTTP_PORT=80
HTTPS_PORT=443
API_PUBLIC_PORT=3000
SIP_PORT=5060
WSS_PORT=7443

# Fail2ban
TZ=UTC
FAIL2BAN_LOG_LEVEL=INFO
FAIL2BAN_DB_PURGE_AGE=7d

# TLS / Let's Encrypt automation is wired in a later frontend/proxy slice.
LETSENCRYPT_EMAIL=admin@example.com
LETSENCRYPT_DOMAIN=dialer.example.com
